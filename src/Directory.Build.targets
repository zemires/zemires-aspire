<Project>
  <Import Project="..\Directory.Build.targets" />

  <PropertyGroup>
    <Authors>zemires, Laurent Christen</Authors>
    <Company>zemires GmbH</Company>
    <Copyright>(c) zemires GmbH. All rights reserved.</Copyright>
    <NeutralLanguage>en</NeutralLanguage>
    <Product>Zemires.Aspire</Product>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/zemires/zemires-aspire</PackageProjectUrl>
    <PackageIcon>nuget.png</PackageIcon>
    <RepositoryUrl>https://github.com/zemires/zemires-aspire</RepositoryUrl>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>

    <PublishRepositoryUrl>true</PublishRepositoryUrl>

    <PackageReadmeFile>$(DocsPath)</PackageReadmeFile>
    <PackageOutputPath>../../nuget</PackageOutputPath>
    <PackageTags>aspire integration zemires $(AdditionalPackageTags)</PackageTags>
  </PropertyGroup>

  <!--
    Create local branding
  -->
  <PropertyGroup Condition=" '$(ContinuousIntegrationBuild)' == 'false' AND  '$(VersionSuffix)' == ''  ">
    <_VersionSuffix>$([System.DateTime]::Now.ToString(yyMMdd-HHmm))</_VersionSuffix>
    <VersionSuffix>dev.$(_VersionSuffix)</VersionSuffix>
    <PackageVersion>$(VersionPrefix)-$(VersionSuffix)</PackageVersion>
  </PropertyGroup>

  <PropertyGroup>
    <WarningsAsErrors>$(DefaultWarningsAsErrors);$(WarningsAsErrors)</WarningsAsErrors>
  </PropertyGroup>
</Project>