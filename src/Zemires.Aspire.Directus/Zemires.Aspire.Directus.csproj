<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AdditionalPackageTags>client directus cms headless</AdditionalPackageTags>
    <Description>A .NET Aspire client integration registering the Directus client with health checks.</Description>
    <!-- Released as prerelease package only (see IsPreview in src/Directory.Build.props). -->
    <IsPreview>true</IsPreview>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Qute.Directus" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\HealthCheckExtensions.cs" Link="Shared\HealthCheckExtensions.cs" />
  </ItemGroup>

</Project>
