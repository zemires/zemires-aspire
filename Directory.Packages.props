<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Packable (src) projects reference the lowest supported Aspire; everything else uses the latest. -->
    <AspirePackageVersion>$(AspireVersion)</AspirePackageVersion>
    <AspirePackageVersion Condition="'$(IsPackable)' == 'true'">$(AspireMinimumVersion)</AspirePackageVersion>
  </PropertyGroup>
  <ItemGroup Label="Aspire Packages">
    <PackageVersion Include="Aspire.Hosting" Version="$(AspirePackageVersion)" />
    <!-- Aspire.AppHost.Sdk projects get Aspire.Hosting.AppHost implicitly (NU1009 otherwise); Microsoft.NET.Sdk projects reference it explicitly. -->
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="$(AspirePackageVersion)" Condition="'$(_UsingAspireAppHostSdk)' != 'true'" />
    <PackageVersion Include="Aspire.Hosting.Azure" Version="$(AspirePackageVersion)" />
    <PackageVersion Include="Aspire.Hosting.Foundry" Version="$(AspireVersion)$(AspirePreviewSuffix)" />
    <PackageVersion Include="Aspire.Hosting.Azure.AppContainers" Version="$(AspirePackageVersion)" />
    <PackageVersion Include="Aspire.Hosting.Azure.ApplicationInsights" Version="$(AspirePackageVersion)" />
    <PackageVersion Include="Aspire.Hosting.Azure.CosmosDB" Version="$(AspirePackageVersion)" />
    <PackageVersion Include="Aspire.Hosting.Azure.EventHubs" Version="$(AspirePackageVersion)" />
    <PackageVersion Include="Aspire.Hosting.Azure.KeyVault" Version="$(AspirePackageVersion)" />
    <PackageVersion Include="Aspire.Hosting.Azure.PostgreSQL" Version="$(AspirePackageVersion)" />
    <PackageVersion Include="Aspire.Hosting.Azure.Redis" Version="$(AspirePackageVersion)" />
    <PackageVersion Include="Aspire.Hosting.Azure.Search" Version="$(AspirePackageVersion)" />
    <PackageVersion Include="Aspire.Hosting.Azure.ServiceBus" Version="$(AspirePackageVersion)" />
    <PackageVersion Include="Aspire.Hosting.Azure.SignalR" Version="$(AspirePackageVersion)" />
    <PackageVersion Include="Aspire.Hosting.Azure.Sql" Version="$(AspirePackageVersion)" />
    <PackageVersion Include="Aspire.Hosting.Azure.Storage" Version="$(AspirePackageVersion)" />
    <PackageVersion Include="Aspire.Hosting.Integration.Analyzers" Version="$(AspireVersion)$(AspirePreviewSuffix)" />
    <PackageVersion Include="Aspire.Hosting.JavaScript" Version="$(AspirePackageVersion)" />
    <PackageVersion Include="Aspire.Hosting.Milvus" Version="$(AspirePackageVersion)" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="$(AspirePackageVersion)" />
    <PackageVersion Include="Aspire.Hosting.Redis" Version="$(AspirePackageVersion)" />
    <PackageVersion Include="Aspire.Hosting.SqlServer" Version="$(AspirePackageVersion)" />
    <PackageVersion Include="Aspire.Microsoft.Azure.StackExchangeRedis" Version="$(AspirePackageVersion)" />
    <PackageVersion Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" Version="$(AspireVersion)$(AspirePreviewSuffix)" />
    <PackageVersion Include="Aspire.StackExchange.Redis.OutputCaching" Version="$(AspirePackageVersion)" />
    <PackageVersion Include="CommunityToolkit.Aspire.Hosting.JavaScript.Extensions" Version="17.0.0-beta.1052" />
    <PackageVersion Include="CommunityToolkit.Aspire.Hosting.Ollama" Version="17.0.0-beta.1052" />
    <PackageVersion Include="CommunityToolkit.Aspire.Hosting.OpenTelemetryCollector" Version="17.0.0-beta.1052" />
  </ItemGroup>
  <ItemGroup Label="Core Packages">
    <PackageVersion Include="AspNetCore.HealthChecks.NpgSql" Version="9.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="$(AspNetCoreVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="$(DotNetExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="$(DotNetExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="$(DotNetExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="$(DotNetExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="$(DotNetExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="$(ServiceDiscoveryVersion)" />
    <PackageVersion Include="Microsoft.OpenApi" Version="2.13.0" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.403" />
    <!-- OpenTelemetry packages -->
    <PackageVersion Include="Azure.Monitor.OpenTelemetry.AspNetCore" Version="1.6.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.20.1" />
  </ItemGroup>
  <ItemGroup Label="Integration Packages">
    <PackageVersion Include="BCrypt.Net-Next" Version="4.2.1" />
    <PackageVersion Include="CockroachDB.EFCore.Provider" Version="0.1.0" />
    <PackageVersion Include="Handlebars.Net" Version="2.4.3" />
    <PackageVersion Include="Handlebars.Net.Extension.Json" Version="1.0.0" />
    <PackageVersion Include="Handlebars.Net.Helpers" Version="2.5.5" />
    <PackageVersion Include="Handlebars.Net.Helpers.DynamicLinq" Version="2.5.5" />
    <PackageVersion Include="Microsoft.Kiota.Bundle" Version="2.1.6" />
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.3.1" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="Qute.Directus" Version="11.0.1" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.19.0" />
    <!-- Must be >= the version Microsoft.SourceLink.GitHub pulls into src restore graphs, or consumers get an older assembly than src compiled against. -->
    <PackageVersion Include="System.IO.Hashing" Version="10.0.15" />
    <PackageVersion Include="Zitadel" Version="7.0.44" />
  </ItemGroup>
  <ItemGroup Label="Transitive Security Pins">
    <!-- CVE-2026-70162 / CVE-2026-84008, fixed in 10.0.13. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
  </ItemGroup>
  <ItemGroup Label="Testing">
    <PackageVersion Include="Aspire.Hosting.Testing" Version="$(AspirePackageVersion)" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>
</Project>