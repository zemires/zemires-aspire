resource "azurerm_managed_redis" "{{name}}" {
  name                     = "${replace(local.name_template_short, "<service>", "redis")}{{name}}"
  resource_group_name      = azurerm_resource_group.app.name
  location                 = var.location
  sku_name				         = "{{#if Parameters.SkuName}}{{Parameters.SkuName}}{{else}}Balanced_B0{{/if}}"
  public_network_access    = "Enabled"

  default_database {
    access_keys_authentication_enabled = false
  }

  tags                     = merge (local.tags, {
    aspire-resource-name = "{{name}}"
  })
}

resource "azurerm_managed_redis_access_policy_assignment" "app_{{name}}" {
  managed_redis_id = azurerm_managed_redis.{{name}}.id
  object_id        = azurerm_user_assigned_identity.app.principal_id
}

locals {
  {{name}} = {
    id               = azurerm_managed_redis.{{name}}.id
    name             = azurerm_managed_redis.{{name}}.name
    hostName         = azurerm_managed_redis.{{name}}.hostname
    port             = azurerm_managed_redis.{{name}}.default_database[0].port
    connectionString = "${azurerm_managed_redis.{{name}}.hostname}:${azurerm_managed_redis.{{name}}.default_database[0].port},ssl=true"
  }
}

output "{{name}}" {
  value = local.{{name}}
  sensitive = true
}
